# SaiHarness agent installer for "{{AGENT_NAME}}" -- individual and single-use.
#
# The main harness filled the values below with material generated by code
# (never by a model) and embedded the agent package itself. The enrollment token
# works exactly once: after the first successful enrollment it is burned and this
# script can no longer enroll.
#
# Run on the target host (PowerShell):
#   powershell -ExecutionPolicy Bypass -File installer.ps1

$ErrorActionPreference = 'Stop'

$AgentName   = '{{AGENT_NAME}}'
$MainAddress = '{{MAIN_ADDRESS}}'     # how this host reaches the main harness, e.g. 192.168.1.10:8765
$EnrollToken = '{{ENROLLMENT_TOKEN}}'
$CaCert = @'
{{CA_CERT_PEM}}
'@
$PackageB64 = '{{PACKAGE_B64}}'

$InstallDir = Join-Path $env:LOCALAPPDATA 'SaiHarnessAgent'
$PkgDir = Join-Path $InstallDir 'pkg'
New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null

# Pinned CA: the agent trusts only this authority and talks to no one else.
Set-Content -Path (Join-Path $InstallDir 'ca_cert.pem') -Value $CaCert -Encoding ascii

# Config. Edit "roots" to the folders this agent may touch on this host.
$Config = [ordered]@{
    name    = $AgentName
    address = $MainAddress
    roots   = @("$env:USERPROFILE")
} | ConvertTo-Json
Set-Content -Path (Join-Path $InstallDir 'agent.json') -Value $Config -Encoding utf8

# One-time token (removed by the agent after it enrolls).
Set-Content -Path (Join-Path $InstallDir 'enroll_token.txt') -Value $EnrollToken -Encoding ascii

# Unpack the embedded agent package.
Remove-Item -Recurse -Force $PkgDir -ErrorAction SilentlyContinue
New-Item -ItemType Directory -Force -Path $PkgDir | Out-Null
[IO.File]::WriteAllBytes((Join-Path $InstallDir 'pkg.zip'), [Convert]::FromBase64String($PackageB64))
Expand-Archive -Path (Join-Path $InstallDir 'pkg.zip') -DestinationPath $PkgDir -Force
Remove-Item (Join-Path $InstallDir 'pkg.zip') -Force

# Find a Python interpreter (3.11+).
function Find-Python {
    foreach ($c in @('py', 'python', 'python3')) {
        $exe = (Get-Command $c -ErrorAction SilentlyContinue)
        if ($exe) {
            try { & $exe.Source -c "import sys; raise SystemExit(0 if sys.version_info[:2] >= (3,11) else 1)"; if ($LASTEXITCODE -eq 0) { return $exe.Source } } catch {}
        }
    }
    return $null
}
$Python = Find-Python
if (-not $Python) {
    Write-Host "Installing Python 3.14 via winget..."
    winget install -e --id Python.Python.3.14 --accept-source-agreements --accept-package-agreements
    $Python = Find-Python
}
if (-not $Python) { throw "Python 3.11+ is required and could not be installed automatically." }

# Virtual environment with the two third-party dependencies.
$VenvPy = Join-Path $InstallDir 'venv\Scripts\python.exe'
if (-not (Test-Path $VenvPy)) { & $Python -m venv (Join-Path $InstallDir 'venv') }
& $VenvPy -m pip install --quiet --upgrade pip
& $VenvPy -m pip install --quiet cryptography websockets

$Pythonw = Join-Path $InstallDir 'venv\Scripts\pythonw.exe'
if (-not (Test-Path $Pythonw)) { $Pythonw = $VenvPy }
$HostScript = Join-Path $PkgDir 'core\agent\agent_host.py'
$RunArgs = "`"$HostScript`" --dir `"$InstallDir`""

# Auto-start at logon so the agent reconnects after reboots. Register-ScheduledTask,
# not schtasks.exe, whose /TR value is capped at 261 characters.
try {
    $Action  = New-ScheduledTaskAction -Execute $Pythonw -Argument $RunArgs
    $Trigger = New-ScheduledTaskTrigger -AtLogOn
    Register-ScheduledTask -TaskName "SaiHarnessAgent-$AgentName" -Action $Action -Trigger $Trigger -Force | Out-Null
} catch {
    Write-Host "Note: could not register the logon task ($($_.Exception.Message)); the agent still starts now."
}

Write-Host "Installed agent '$AgentName' -> $MainAddress"
Write-Host "Starting now; it will enroll once with the one-time token and then stay connected."
Start-Process -FilePath $Pythonw -ArgumentList $RunArgs -WindowStyle Hidden
