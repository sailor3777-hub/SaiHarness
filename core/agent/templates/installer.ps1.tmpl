# SaiHarness agent installer for "{{AGENT_NAME}}" -- individual and single-use.
#
# The main harness filled the values below with material generated by code
# (never by a model). The enrollment token works exactly once: after the first
# successful enrollment it is burned and this script can no longer enroll.
#
# Run on the target host (PowerShell):
#   powershell -ExecutionPolicy Bypass -File installer.ps1

$ErrorActionPreference = 'Stop'

$AgentName = '{{AGENT_NAME}}'
$MainAddress = '{{MAIN_ADDRESS}}'     # how this host reaches the main harness, e.g. 192.168.1.10:8765
$EnrollToken = '{{ENROLLMENT_TOKEN}}'
$CaCert = @'
{{CA_CERT_PEM}}
'@

$InstallDir = Join-Path $env:LOCALAPPDATA 'SaiHarnessAgent'
New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null

# The pinned CA certificate: the agent trusts only this authority and talks to no
# one else. Keep it; the private key/certificate the agent gets on enrollment are
# written next to it and must stay on this host.
Set-Content -Path (Join-Path $InstallDir 'ca_cert.pem') -Value $CaCert -Encoding ascii

$Config = @{
    name    = $AgentName
    address = $MainAddress
    # roots the agent is allowed to touch on this host; edit before first run
    roots   = @("$env:USERPROFILE")
} | ConvertTo-Json
Set-Content -Path (Join-Path $InstallDir 'agent.json') -Value $Config -Encoding utf8

Write-Host "Prepared $InstallDir for agent '$AgentName' -> $MainAddress"
Write-Host ""
Write-Host "Next: install the SaiHarness agent package (core.agent.wrapper and its"
Write-Host "dependencies: Python 3.11+, 'cryptography' and 'websockets'), then run the"
Write-Host "wrapper, which enrolls once with the token below and connects over mTLS:"
Write-Host ""
Write-Host "  enrollment token (used once): $EnrollToken"
Write-Host ""
# NOTE: fetching the agent package from the main harness over the pinned channel
# is wired by the main harness's file-serving step; until then, copy the package
# to the host manually and point the wrapper at $InstallDir.
